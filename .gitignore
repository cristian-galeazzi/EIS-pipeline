# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/

# Virtual environment
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage
htmlcov/

# macOS
.DS_Store
._*

# VS Code
.vscode/
.history/

# Claude Code (machine-specific)
.claude/

# Internal planning/docs notes (machine-specific)
PLAN.md
CLAUDE.md

# Session config; user-specific, never commit
session.json
session.json.bak
session.json*.tmp
session*.json

# Knowledge graph; generated locally, never commit
graphify-out/

# Experimental data; never commit (raw measurements, results, sample folders)
*.ism
*.xlsx
*.csv
*.png
*.pdf
P[0-9]*/

# Per-sample parameter calibration; private, never commit
**/calibration/
RISULTATI_CALIBRAZIONE.md

# Private audit trail: verification & calibration scripts (provenance, never commit)
analysis_audit/

# sample_template is tracked (folder structure reference for new users)
!sample_template/
!sample_template/**/.gitkeep
!sample_template/**/README.md

# Bundled synthetic example sample (no real measurements; committable)
!EXAMPLE_SAMPLE/**/*.csv
# public, synthetic-only validation record of the engine migration
!audit/fitting_v2/results/*.csv

# Backup files (both spellings: gitignore matching is case-sensitive on Linux)
backup/
Backup/

# Local results of the public audit scripts; the scripts are tracked, their
# outputs run on private data and never enter the repository
audit/output/

# Collaboration scaffolding (specs, plans, handoffs written while working with the
# assistant): working files, not project content, never committed
docs/superpowers/
